{
  "name": "wow-guild-hub",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "collect:guild": "node scripts/trigger.mjs collect-guild",
    "collect:static": "node scripts/trigger.mjs collect-static",
    "collect:weekly": "node scripts/trigger.mjs collect-weekly",
    "daten:beispiel": "node scripts/beispieldaten.mjs",
    "zeitung:neu": "node scripts/zeitung-neu.mjs",
    "zeitung:ki-test": "node scripts/ki-test.mjs",
    "daten:uebernahme": "node scripts/blobs-uebernahme.mjs",
    "netlify:umgebung": "node scripts/netlify-umgebung.mjs",
    "daten:uebernahme:live": "node scripts/daten-uebernahme-live.mjs",
    "statistik:erkunden": "node scripts/statistik-erkunden.mjs",
    "lint": "oxlint --deny-warnings ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cinzel-decorative": "^5.3.0",
    "@netlify/blobs": "^11.1.9",
    "@netlify/functions": "^6.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.95.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
