{
  "name": "wow-guild-hub",
  "version": "2.1.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "collect:guild": "node scripts/trigger.mjs collect-guild",
    "collect:static": "node scripts/trigger.mjs collect-static",
    "collect:weekly": "node scripts/trigger.mjs collect-weekly",
    "data:sample": "node scripts/sample-data.mjs",
    "data:import": "node scripts/blobs-import.mjs",
    "data:import:live": "node scripts/import-live-data.mjs",
    "newspaper:regenerate": "node scripts/newspaper-regenerate.mjs",
    "newspaper:ai-test": "node scripts/ai-test.mjs",
    "netlify:env": "node scripts/netlify-env.mjs",
    "stats:explore": "node scripts/explore-statistics.mjs",
    "lint": "oxlint --deny-warnings .",
    "check:english": "node scripts/check-english.mjs",
    "daten:beispiel": "npm run data:sample --",
    "daten:uebernahme": "npm run data:import --",
    "daten:uebernahme:live": "npm run data:import:live --",
    "zeitung:neu": "npm run newspaper:regenerate --",
    "zeitung:ki-test": "npm run newspaper:ai-test --",
    "netlify:umgebung": "npm run netlify:env --",
    "statistik:erkunden": "npm run stats:explore --"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cinzel-decorative": "^5.3.0",
    "@netlify/blobs": "^11.1.10",
    "@netlify/functions": "^6.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.95.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
