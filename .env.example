# Example configuration for the guild site. For local development copy it to .env (cp .env.example .env),
# on Netlify enter the same names under Site configuration, Environment variables.
# .env is excluded via .gitignore. Never commit secret values.

# ---------------------------------------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------------------------------------

# Credentials from the Battle.net Developer Portal (https://develop.battle.net/access/clients). Secret.
BNET_CLIENT_ID=
BNET_CLIENT_SECRET=

# Guild slug as used by the Blizzard API: lowercase, spaces become hyphens, umlauts stay
# (e.g. "goldene-bärenklaue"). Several guilds comma-separated, the first one is the main guild.
GUILD_SLUGS=meine-gilde

# ---------------------------------------------------------------------------------------------------------
# Game and Blizzard API (optional)
# ---------------------------------------------------------------------------------------------------------

# Game version. Currently only "forever" (WoW Forever) is supported, Retail and Classic will follow.
WOW_VERSION=forever
# API region: eu, us, kr or tw.
BNET_REGION=eu
# Language of the game data (names of items, spells, instances).
BNET_LOCALE=de_DE

# ---------------------------------------------------------------------------------------------------------
# Guild (optional)
# ---------------------------------------------------------------------------------------------------------

# Rank names as JSON: one list per guild slug, position = rank number (0 is the guild master).
# Without it the site shows "Rang 0", "Rang 1" and so on.
GUILD_RANKS={"meine-gilde":["Gildenmeister","Offizier","Veteran","Mitglied","Twink","Neuling"]}

# Twink ranks, comma-separated rank names as written in GUILD_RANKS (case does not matter).
# WoW Forever reports account-wide achievements (class, professions, dungeon explorer) as completed on every
# character of the account. They count only for characters without a twink rank. Without it they count everywhere.
TWINK_RANKS=Twink

# Characters excluded from the weekly fun titles, comma-separated: slug, name or character ID.
TITLE_OPT_OUTS=

# ---------------------------------------------------------------------------------------------------------
# Site appearance and details (optional, applied at build time, changes need a rebuild)
# ---------------------------------------------------------------------------------------------------------

# Site name in header, title and share preview. Default: "Gildenseite".
WEBSITE_NAME=Meine Gilde
# Offered languages, comma-separated: de, en, schwaebisch, bayrisch. German is always included.
# Default: de,en. A single language hides the language switcher.
WEBSITE_LANGUAGES=de,en
# Name of the weekly newspaper. Default: "Gildenblatt" in German, "Guild Gazette" in English.
WEBSITE_NEWSPAPER=
# Description for search engines and share preview.
WEBSITE_DESCRIPTION=Mitglieder, Charaktere, Berufe, Dungeons und Raids der Gilde Meine Gilde.
# Line in the page footer, e.g. a motto. Empty means no line.
WEBSITE_TAGLINE=
# Images: path below web/public (e.g. /meine-gilde/logo.png) or a full https address.
# Default is the neutral crest: /logo.svg, as PNG for home screen and share preview (iPhones, Discord
# and Facebook do not show SVG). A custom WEBSITE_LOGO is used wherever nothing else is set.
WEBSITE_LOGO=
WEBSITE_LOGO_ALT=
WEBSITE_FAVICON=
WEBSITE_APPLE_ICON=
# Share preview, ideally 1200 x 630 pixels.
WEBSITE_OG_IMAGE=
# Color of the browser bar on mobile.
WEBSITE_THEME_COLOR=#14161c
# Override colors: name=value pairs separated by semicolons, names from web/src/styles/theme.css without "--".
# Example for blue instead of gold: gold-pale=#cfe3ff;gold-1=#7fb3ff;gold-2=#3f7fd6;gold-3=#25508f
WEBSITE_COLORS=
# Discord invite, https addresses only. Empty means no Discord link.
WEBSITE_DISCORD=

# Imprint and privacy policy appear only with a name (required for such sites in Germany).
# Address: separate lines with |.
WEBSITE_IMPRINT_NAME=
WEBSITE_IMPRINT_ADDRESS=
WEBSITE_IMPRINT_EMAIL=

# Visitor statistics with Umami Cloud (https://umami.is), only with an ID. The privacy policy then explains them.
# Domains: comma-separated list of domains to count on (e.g. meine-gilde.netlify.app).
WEBSITE_UMAMI_ID=
WEBSITE_UMAMI_DOMAINS=

# ---------------------------------------------------------------------------------------------------------
# Collectors (optional, the defaults usually fit)
# ---------------------------------------------------------------------------------------------------------

# Concurrent requests to the Blizzard API per run.
COLLECT_CONCURRENCY=10
# Time budget per run in milliseconds. Netlify aborts scheduled functions after 15 s.
COLLECT_BUDGET_MS=12000

# Local Docker only: triggers the scheduled collectors on a timer (on or off), interval in minutes.
LOCAL_SCHEDULER=on
LOCAL_SCHEDULER_GUILD_MINUTES=60

# ---------------------------------------------------------------------------------------------------------
# Weekly newspaper with AI texts (optional)
# ---------------------------------------------------------------------------------------------------------

# With base URL and key of an Anthropic-compatible gateway, Claude writes the newspaper texts,
# otherwise fixed text blocks are used. If either is missing or the call fails, the text blocks take over.
# Deliberately not ANTHROPIC_API_KEY: Netlify's own AI Gateway sets it in every function by itself.
# The gateway URL never belongs in the repo.
NEWSPAPER_AI_URL=
NEWSPAPER_AI_KEY=
NEWSPAPER_AI_MODEL=anthropic-router
# on: send output_config (effort and JSON schema), only if the gateway understands it.
NEWSPAPER_AI_OUTPUT_CONFIG=
NEWSPAPER_AI_EFFORT=low

# ---------------------------------------------------------------------------------------------------------
# Tools (local only)
# ---------------------------------------------------------------------------------------------------------

# ID of the Netlify site for the script daten:uebernahme:live.
NETLIFY_SITE_ID=
