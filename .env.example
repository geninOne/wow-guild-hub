# Beispielkonfiguration der Gildenseite. Für die lokale Entwicklung nach .env kopieren (cp .env.example .env),
# auf Netlify dieselben Namen unter Site configuration, Environment variables eintragen.
# Die .env ist per .gitignore ausgeschlossen. Werte von Geheimnissen nie committen.

# ---------------------------------------------------------------------------------------------------------
# Pflicht
# ---------------------------------------------------------------------------------------------------------

# Zugangsdaten aus dem Battle.net Developer Portal (https://develop.battle.net/access/clients). Geheim.
BNET_CLIENT_ID=
BNET_CLIENT_SECRET=

# Slug der Gilde, wie er in der Blizzard-API steht: Kleinbuchstaben, Leerzeichen als Bindestrich,
# Umlaute bleiben (z. B. "goldene-bärenklaue"). Mehrere Gilden kommagetrennt, die erste ist die Hauptgilde.
GUILD_SLUGS=meine-gilde

# ---------------------------------------------------------------------------------------------------------
# Spiel und Blizzard-API (optional)
# ---------------------------------------------------------------------------------------------------------

# Spielversion. Derzeit wird nur "forever" (WoW Forever) unterstützt, Retail und Classic folgen.
WOW_VERSION=forever
# Region der API: eu, us, kr oder tw.
BNET_REGION=eu
# Sprache der Spieldaten (Namen von Gegenständen, Zaubern, Instanzen).
BNET_LOCALE=de_DE

# ---------------------------------------------------------------------------------------------------------
# Gilde (optional)
# ---------------------------------------------------------------------------------------------------------

# Rangnamen als JSON: je Gilden-Slug eine Liste, Position = Rangnummer (0 ist der Gildenmeister).
# Ohne Angabe zeigt die Seite "Rang 0", "Rang 1" usw.
GUILD_RANKS={"meine-gilde":["Gildenmeister","Offizier","Veteran","Mitglied","Twink","Neuling"]}

# Charaktere ohne Spaßtitel der Woche, kommagetrennt: Slug, Name oder Charakter-ID.
TITEL_ABMELDUNGEN=

# ---------------------------------------------------------------------------------------------------------
# Aussehen und Angaben der Seite (optional, werden beim Bauen eingesetzt, Änderungen brauchen einen Neubau)
# ---------------------------------------------------------------------------------------------------------

# Name der Seite in Kopf, Titel und Teilen-Vorschau. Standard: "Gildenseite".
SEITE_NAME=Meine Gilde
# Angebotene Sprachen, kommagetrennt: de, en, schwaebisch, bayrisch. Deutsch ist immer dabei.
# Standard: de,en. Eine Sprache allein blendet den Sprachumschalter aus.
SEITE_SPRACHEN=de,en
# Name der Wochenzeitung. Standard: "Gildenblatt" auf Deutsch, "Guild Gazette" auf Englisch.
SEITE_ZEITUNG=
# Beschreibung für Suchmaschinen und Teilen-Vorschau.
SEITE_BESCHREIBUNG=Mitglieder, Charaktere, Berufe, Dungeons und Raids der Gilde Meine Gilde.
# Zeile im Fuß der Seite, z. B. ein Motto. Leer heißt keine Zeile.
SEITE_UNTERTITEL=
# Bilder: Pfad unter web/public (z. B. /meine-gilde/logo.png) oder volle https-Adresse.
# Standard ist das neutrale Wappen: /logo.svg, für Homescreen und Teilen-Vorschau als PNG (iPhones, Discord
# und Facebook zeigen kein SVG). Mit eigenem SEITE_LOGO gilt dieses überall, wo nichts anderes gesetzt ist.
SEITE_LOGO=
SEITE_LOGO_ALT=
SEITE_FAVICON=
SEITE_APPLE_ICON=
# Teilen-Vorschau, ideal 1200 x 630 Pixel.
SEITE_OG_BILD=
# Farbe der Browserleiste auf dem Handy.
SEITE_THEME_COLOR=#14161c
# Farben überschreiben: Paare name=wert mit Semikolon, Namen aus web/src/styles/theme.css ohne "--".
# Beispiel für Blau statt Gold: gold-pale=#cfe3ff;gold-1=#7fb3ff;gold-2=#3f7fd6;gold-3=#25508f
SEITE_FARBEN=
# Einladung zum Discord, nur https-Adressen. Leer heißt kein Discord-Link.
SEITE_DISCORD=

# Impressum und Datenschutzerklärung erscheinen nur mit Name (in Deutschland Pflicht für solche Seiten).
# Anschrift: Zeilen mit | trennen.
SEITE_IMPRESSUM_NAME=
SEITE_IMPRESSUM_ANSCHRIFT=
SEITE_IMPRESSUM_EMAIL=

# Besucherstatistik mit Umami Cloud (https://umami.is), nur mit ID. Die Datenschutzerklärung erklärt sie dann.
# Domains: kommagetrennt, auf denen gezählt wird (z. B. meine-gilde.netlify.app).
SEITE_UMAMI_ID=
SEITE_UMAMI_DOMAINS=

# ---------------------------------------------------------------------------------------------------------
# Sammler (optional, die Standardwerte passen meistens)
# ---------------------------------------------------------------------------------------------------------

# Gleichzeitige Anfragen an die Blizzard-API je Lauf.
COLLECT_CONCURRENCY=10
# Zeitbudget je Lauf in Millisekunden. Netlify bricht geplante Functions nach 15 s ab.
COLLECT_BUDGET_MS=12000

# Nur lokal in Docker: löst die geplanten Sammler im Takt aus (an oder aus), Abstand in Minuten.
TAKT=an
TAKT_GILDE_MINUTEN=60

# ---------------------------------------------------------------------------------------------------------
# Wochenzeitung mit KI-Texten (optional)
# ---------------------------------------------------------------------------------------------------------

# Mit Basis-URL und Schlüssel eines Anthropic-kompatiblen Gateways schreibt Claude die Texte der Wochenzeitung,
# sonst feste Satzbausteine. Fehlt eines davon oder scheitert der Aufruf, springen die Satzbausteine ein.
# Bewusst nicht ANTHROPIC_API_KEY: Den setzt Netlifys eigenes AI Gateway in jeder Function von selbst.
# Die URL des Gateways gehört nie ins Repo.
ZEITUNG_KI_URL=
ZEITUNG_KI_SCHLUESSEL=
ZEITUNG_MODELL=anthropic-router
# an: output_config (Aufwand und JSON-Schema) mitschicken, nur wenn das Gateway es versteht.
ZEITUNG_KI_OUTPUT_CONFIG=
ZEITUNG_AUFWAND=low

# ---------------------------------------------------------------------------------------------------------
# Werkzeuge (nur lokal)
# ---------------------------------------------------------------------------------------------------------

# ID der Netlify-Site für das Skript daten:uebernahme:live.
NETLIFY_SITE_ID=
